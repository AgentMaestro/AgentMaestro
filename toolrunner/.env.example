TOOLRUNNER_SECRET=replace-me
TOOLRUNNER_SANDBOX_ROOT=/tmp/agentmaestro/sandbox
TOOLRUNNER_TIMEOUT=30
TOOLRUNNER_OUTPUT_LIMIT=4096
TOOLRUNNER_ALLOWED_COMMANDS=python3,python
TOOLRUNNER_PYTHON=.venv\Scripts\python.exe
# Guardrails around where repo_tree/search tools can operate.
# Exclude list trumps the allow list.
TOOLRUNNER_ALLOW_TO_SEARCH_LIST=C:/Dev/AgentMaestro,C:/tmp/agentmaestro/sandbox
TOOLRUNNER_EXCLUDE_FROM_SEARCH_LIST=**/.git/**,**/.venv/**,**/node_modules/**,**/__pycache__/**,**/.pytest_cache/**,**/media/**,**/staticfiles/**,**/*.pyc,**/*.sqlite3,.env
#
# Optional: override the pytest basetemp directory used by toolrunner/scripts/test.ps1.
# Supports environment expansion (e.g. %LOCALAPPDATA%).
PYTEST_DIR=C:\tmp\agentmaestro\sandbox\pytest_temp
TOOLRUNNER_WEB_SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
TOOLRUNNER_WEB_SEARCH_TIMEOUT_SECONDS=10
TOOLRUNNER_FETCH_TIMEOUT_SECONDS=10
TOOLRUNNER_FETCH_MAX_BYTES=1048576
