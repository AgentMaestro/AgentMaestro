DJANGO_SETTINGS_MODULE=agentmaestro.settings.dev
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CHANNEL_LAYER_REDIS_URL=redis://127.0.0.1:6379/1
DJANGO_SECRET_KEY=replace-me
# Canonical local timezone for the app and agent prompt. Use an IANA name.
TIME_ZONE=America/New_York

# LLM <-> TOOLRUNNER BRIDGE SHARED SECRET
TOOLRUNNER_SECRET=replace-me
TOOLRUNNER_BASE_URL=http://127.0.0.1:8001
TOOLRUNNER_MAX_CONCURRENT_TOOL_CALLS_PER_RUN=6
TOOLRUNNER_GMAIL_OR_CLAUSE_LIMIT=10
TANGO_TIME_ZONE=America/New_York

# OPENAI Connection mode
OPENAI_TRANSPORT=ws
OPENAI_HTTP_MODE=responses
OPENAI_BASE_URL=https://api.openai.com
OPENAI_WS_TIMEOUT_SECONDS=60
OPENAI_WS_IDLE_TIMEOUT_SECONDS=60
OPENAI_WS_DEBUG=0
OPENAI_WS_MAX_RETRIES=3
OPENAI_WS_MAX_RETRY_JITTER_MS=250
OPENAI_MODELS_REFRESH_INTERVAL_HOURS=24

# GEMINI OpenAI-compatible HTTP endpoint
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TRANSPORT=http
# 1 shows condensed system logs; 0 shows full payloads and raw responses.
SHOW_CONDENSED_SYSTEM_LOGS=1

# TELEGRAM BOT
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_INTERVAL_SECONDS=5
TELEGRAM_POLL_TIMEOUT_SECONDS=5
TELEGRAM_POLL_LOCK_TIMEOUT_SECONDS=30
TELEGRAM_POLL_LOCK_REDIS_URL=

GOOGLE_OAUTH_SCOPES=["openid","email","profile","https://www.googleapis.com/auth/gmail.readonly","https://www.googleapis.com/auth/gmail.modify","https://www.googleapis.com/auth/gmail.settings.basic","https://www.googleapis.com/auth/calendar.readonly","https://www.googleapis.com/auth/calendar","https://www.googleapis.com/auth/drive.readonly","https://www.googleapis.com/auth/documents.readonly","https://www.googleapis.com/auth/spreadsheets.readonly","https://www.googleapis.com/auth/contacts.readonly","https://www.googleapis.com/auth/contacts"]
GOOGLE_PRIMARY_ACCOUNT=
GOOGLE_BRIDGE_TIMEOUT_SECONDS=30
GOOGLE_BRIDGE_RETRY_ATTEMPTS=2
GOOGLE_BRIDGE_RETRY_BACKOFF_SECONDS=1
GOOGLE_BRIDGE_RETRY_MAX_BACKOFF_SECONDS=8
