DJANGO_SETTINGS_MODULE=agentmaestro.settings.dev
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CHANNEL_LAYER_REDIS_URL=redis://127.0.0.1:6379/1
USE_REDIS_CHANNEL_LAYER=1
DJANGO_SECRET_KEY=replace-me

# LLM <-> TOOLRUNNER BRIDGE SHARED SECRET
TOOLRUNNER_SECRET=replace-me
TOOLRUNNER_BASE_URL=http://127.0.0.1:8001
RUN_TOOLRUNNER_BRIDGE_TESTS=1

# OPENAI Connection mode
OPENAI_TRANSPORT=http
OPENAI_HTTP_MODE=responses
OPENAI_BASE_URL=https://api.openai.com
OPENAI_WS_TIMEOUT_SECONDS=60
OPENAI_WS_IDLE_TIMEOUT_SECONDS=60
OPENAI_WS_DEBUG=0
OPENAI_WS_MAX_RETRIES=3
OPENAI_WS_MAX_RETRY_JITTER_MS=250

# TELEGRAM BOT
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_INTERVAL_SECONDS=5
TELEGRAM_POLL_TIMEOUT_SECONDS=25
TELEGRAM_POLL_LOCK_TIMEOUT_SECONDS=30
TELEGRAM_POLL_LOCK_REDIS_URL=
